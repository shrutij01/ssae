  "figures": [
    {
      "caption": "Gemma-2-2B complete 5-dataset \u00d7 9-model signed endpoint matrix. Each model and dataset has one gray no-steering vertex. The red signed-positive ray ends at cos(z0 + \u03b1d, z1); the blue signed-negative control ends at cos(z0 \u2212 \u03b1d, z1). Both rays therefore share one origin and one target. Decoder selection, orientation, and least-squares scale use only concept-labeled cfc_train rows; cfc_test supplies every plotted endpoint. Values average concepts within seed and then three seeds. Population SD across seeds is retained in endpoint_summary.csv and deliberately omitted from this figure. Controls are retained in separate numeric tables to avoid overloading the rays.",
      "id": "signed_endpoint_rays_gemma",
      "title": "Gemma-2-2B signed endpoint steering",
      "variants": [
        "figures/signed-endpoint-rays-gemma.pdf"
      ]
    },
    {
      "caption": "Pythia-70M complete 5-dataset \u00d7 9-model signed endpoint matrix. Each model and dataset has one gray no-steering vertex. The red signed-positive ray ends at cos(z0 + \u03b1d, z1); the blue signed-negative control ends at cos(z0 \u2212 \u03b1d, z1). Both rays therefore share one origin and one target. Decoder selection, orientation, and least-squares scale use only concept-labeled cfc_train rows; cfc_test supplies every plotted endpoint. Values average concepts within seed and then three seeds. Population SD across seeds is retained in endpoint_summary.csv and deliberately omitted from this figure. Controls are retained in separate numeric tables to avoid overloading the rays.",
      "id": "signed_endpoint_rays_pythia",
